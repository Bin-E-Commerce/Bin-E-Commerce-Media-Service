# Copy file này thành `.env` khi chạy Media Service local.
# Không commit `.env`, AWS credential hoặc internal service token lên Git.
#
# Quy tắc theo môi trường:
# - Chạy trực tiếp trên máy: dùng localhost và credential AWS của profile local.
# - Docker Compose/Kubernetes: dùng DNS nội bộ cho service; ưu tiên IAM Role/IRSA.
# - Production: inject secret từ Secret Manager, không ghi secret vào image.

# ============================================================================
# 01 · Runtime và HTTP API
# Media tạo presigned upload và quản lý asset; file đi trực tiếp lên S3.
# ============================================================================

APP_VERSION=1.0.0                                      # Version hiển thị trong health response
NODE_ENV=development                                   # development | test | production
PORT=3004                                              # Port local và port nội bộ của container

# ============================================================================
# 02 · Gọi service nội bộ
# Media dùng Auth Service để lấy profile và kiểm tra ownership của asset.
# ============================================================================

AUTH_SERVICE_URL=http://localhost:3002                  # Docker/K8s: http://auth-service:3001
INTERNAL_SERVICE_TOKEN=

# ============================================================================
# 03 · AWS S3 và CDN public
# Runtime production nên nhận quyền S3 qua IAM Role; local/demo mới dùng hai key dưới đây.
# ============================================================================

AWS_REGION=ap-southeast-1                              # Region của bucket S3
AWS_S3_BUCKET=bin-ecommerce                              # Bucket lưu ảnh/video gốc và đã xử lý
AWS_ACCESS_KEY_ID=                                      # Để trống trong file mẫu; cấp từ IAM khi chạy local
AWS_SECRET_ACCESS_KEY=                                  # Để trống trong file mẫu; không commit secret thật
MEDIA_PUBLIC_CDN_URL=https://cdn.example.com            # Base URL CloudFront dùng để đọc asset

# ============================================================================
# 04 · Giới hạn request và chính sách upload
# ============================================================================

MEDIA_REQUEST_BODY_LIMIT=12mb                          # Giới hạn JSON/urlencoded cho payload nội bộ
MEDIA_UPLOAD_EXPIRES_SECONDS=300                       # Presigned policy hết hạn sau 5 phút
MEDIA_MAX_UPLOAD_SIZE_BYTES=5242880                     # Giới hạn ảnh mặc định 5 MB
