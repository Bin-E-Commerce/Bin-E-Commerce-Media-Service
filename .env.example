# ============================================================
# Media Service Environment
# ============================================================
# Scope:
# - Copy to services/media-service/.env for local standalone runs.
# - In production, inject these values only into media-service/Lambda by
#   Secret Manager, Kubernetes Secret, ECS Task Definition, or CI/CD secrets.
# - Do not put auth, database, SMTP, or unrelated service secrets here.
# ============================================================

# Runtime
NODE_ENV=development
PORT=3004

# Internal service communication
AUTH_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_TOKEN=replace-with-the-same-long-random-secret-as-auth-service

# AWS / S3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=bin-ecommerce-media-dev

# Public CDN
MEDIA_PUBLIC_CDN_URL=https://cdn.example.com

# Upload policy
MEDIA_UPLOAD_EXPIRES_SECONDS=300
MEDIA_MAX_UPLOAD_SIZE_BYTES=5242880
